# Supabase → Project settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Supabase → Connect → Session pooler URI (only used by `pnpm db:migrate`)
DATABASE_URL=

# Apify API token (console.apify.com → Settings → Integrations)
APIFY_TOKEN=

# Public URL of this app, used for auth redirects and scraper webhooks
NEXT_PUBLIC_APP_URL=http://localhost:3100
# Random strings: protect the scraper webhook and the cron endpoint
WEBHOOK_SECRET=
CRON_SECRET=
