# Supabase → Project settings → API keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_…), server only
SUPABASE_SECRET_KEY=

# Apify API token (console.apify.com → Settings → API & Integrations)
APIFY_TOKEN=

# Public URL of this app, used for auth redirects and scraper webhooks
NEXT_PUBLIC_APP_URL=http://localhost:3100
# Random strings that protect the scraper webhook and the cron endpoint
WEBHOOK_SECRET=
CRON_SECRET=
